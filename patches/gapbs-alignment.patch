new file mode 100644
index 0000000..8fb8428
--- /dev/null
+++ b/src/aligned_alloc.h
@@ -0,0 +1,17 @@
+#ifndef ALIGNED_ALLOC_H
+#define ALIGNED_ALLOC_H
+
+#include <cstdlib>
+#include <new>
+
+template <typename T>
+T* allocate_aligned(size_t count) {
+	void *ptr = nullptr;
+	if (posix_memalign(&ptr, 2UL*1024*1024, count*sizeof(T)) != 0) {
+		throw std::bad_alloc();
+	}
+
+	return static_cast<T*>(ptr);
+}
+
+#endif
